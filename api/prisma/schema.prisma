generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Server-side tunable limits (PRD §6.2)
model ServerConfig {
  key   String @id
  value String
}

model Account {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  country       String   // ISO2, explicit (ACC-2, DIS-1)
  lastMode      String   @default("customer") // customer|business (ACC-3)
  avatarKey     String?  // customer profile photo
  tagline       String?  // short customer bio
  displayName   String?  // shown to businesses in chat + inbox
  showEmail     Boolean  @default(false) // opt-in: business may see email
  showPhone     Boolean  @default(false) // opt-in: business may see phone
  contactPhone  String?  // user-provided, unverified (no OTP)
  showContactPhone Boolean @default(false) // opt-in: business may see it
  headerKey     String?  // customer profile header background
  passwordHash  String?  // optional 2nd step: OTP + password (ACC-1)
  lastSeenAt    DateTime? // presence dot (online < 2min)
  createdAt     DateTime @default(now())
  businesses    Business[]
  threads       Thread[] @relation("CustomerThreads")
  messages      Message[]
  reports       Report[]
  events        Event[]
  support       SupportMessage[]
  reads         ThreadRead[]
}

model Business {
  id            String   @id @default(cuid())
  ownerId       String
  owner         Account  @relation(fields: [ownerId], references: [id])
  name          String
  slug          String   @unique
  category      String
  country       String   // visibility boundary (DIS-1)
  city          String   // selectable filter + primary rank (DIS-2/DIS-3)
  area          String?
  deliveryArea  String?
  logoKey       String?
  coverKey      String?   // storefront header image, owner-chosen (cover)
  bio           String?   // owner-written, max 250 words
  hidden        Boolean  @default(false) // admin take-down (TRU-1)
  suspended     Boolean  @default(false) // admin store suspension (manual)
  createdAt     DateTime @default(now())
  listings      Listing[]
  collections   Collection[]
  certificates  Certificate[]
  statuses      Status[]
  threads       Thread[]

  @@index([country, city])
  @@index([category])
}

model Listing {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type         String   // product|service (LST-2)
  title        String
  price        String?  // string to allow ranges + "on request" (LST-6)
  description  String?  // short seller-written blurb (brand polish)
  currency     String   @default("NGN")
  availability String   @default("in_stock") // in_stock|limited|sold_out|made_to_order (LST-5)
  photos       String[] // R2 keys, 1..5 (LST-1)
  included     String?  // services: what's included (LST-2)
  hidden       Boolean  @default(false) // admin take-down (TRU-1)
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@index([title])
}

model Collection {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
}

// ONB-11: optional self-reported certificates (max 3, app-enforced).
// Never styled as verified — the TRU-3 tag stays separate.
model Certificate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  issuer     String?
  year       Int?
  photo      String   // R2 key
  createdAt  DateTime @default(now())
}

model Status {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String   // photo|text (STA-1)
  imageKey   String?
  text       String?
  bg         String?
  caption    String?  // photo overlay line
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([businessId, expiresAt])
}

model Thread {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Account  @relation("CustomerThreads", fields: [customerId], references: [id])
  listingId   String?
  createdAt DateTime @default(now())
  messages    Message[]
  reads       ThreadRead[]

  @@index([businessId])
  @@index([customerId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    Account  @relation(fields: [senderId], references: [id])
  body      String?
  imageKey  String?
  createdAt DateTime @default(now())

  @@index([threadId])
}

model Report {
  id        String   @id @default(cuid())
  reporterId String
  reporter  Account  @relation(fields: [reporterId], references: [id])
  targetType String  // profile|listing|status|chat (TRU-1)
  targetId   String
  reason     String
  resolved   Boolean  @default(false) // triaged in /admin
  action     String?  // dismiss|hide (+ note), set on resolve
  contact    String?  // reporter-supplied email/phone for follow-up
  createdAt DateTime @default(now())
}

model Event {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  name      String   // onboarding_step, first_listing, go_live, search, storefront_view, chat_started, first_reply, status_post (ANA-1)
  props     Json?
  createdAt DateTime @default(now())

  @@index([name])
}

// Support inbox (web Support page → /admin): flat per-account thread.
model SupportMessage {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  body      String
  fromAdmin Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([accountId])
}

// Read receipts: per-account per-thread watermark for unread badges.
model ThreadRead {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())

  @@unique([threadId, accountId])
}
