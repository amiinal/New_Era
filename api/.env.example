# API
DATABASE_URL=postgresql://newera:newera@localhost:5432/newera
APP_URL=http://localhost:5173
PORT=4000

# Storage — Cloudflare R2 (S3-compatible, cloud)
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=newera
R2_PUBLIC_URL=https://img.yourdomain.com

# Mail — resend (primary) | zeptomail (budget) | console (local)
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM="New Era <hello@yourdomain.com>"
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=noreply@yourdomain.com
ZEPTOMAIL_URL=https://cpaas.zoho.com/v1.1/email

OTP_MODE=console
JWT_SECRET=change-me-to-32-random-characters-minimum
SENTRY_DSN=

# Admin — comma-separated emails allowed into /admin (TRU-1)
ADMIN_EMAILS=you@example.com
